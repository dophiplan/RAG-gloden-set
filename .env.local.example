# ==========================================
# REQUIRED ENVIRONMENT VARIABLES
# ==========================================

# Supabase Configuration
# Get these from your Supabase project settings
# https://supabase.com/docs/guides/getting-started/quickstarts/nextjs
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Anthropic API Key (Primary translation service)
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key

# ==========================================
# OPTIONAL ENVIRONMENT VARIABLES
# ==========================================

# OpenAI API Key (Used for context review feature)
# Get your API key from https://platform.openai.com/api-keys
# Leave empty to skip context review feature
OPENAI_API_KEY=your_openai_api_key

# Email Provider (Default: 'mock' - no emails sent)
# Options: 'mock', 'smtp', 'sendgrid'
# EMAIL_PROVIDER=mock

# SMTP Configuration (used when EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_app_password
# SMTP_FROM=noreply@example.com
# SMTP_FROM_NAME="Translation Manager"

# SendGrid Configuration (used when EMAIL_PROVIDER=sendgrid)
# SENDGRID_API_KEY=your_sendgrid_api_key
# SENDGRID_FROM=noreply@example.com
# SENDGRID_FROM_NAME="Translation Manager"

# Application URL (Default: http://localhost:3000)
# Set this when deploying to production
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# OBSERVABILITY SETTINGS
# ==========================================

# Log Level (debug | info | warn | error)
# Default: info in production, debug in development
# LOG_LEVEL=info

# Enable Metrics Collection (true | false)
# Default: true
# ENABLE_METRICS=true

# Metrics Token (for securing /api/metrics endpoint)
# Generate: openssl rand -hex 32
# Leave empty to allow internal network access only
# METRICS_TOKEN=your_metrics_token_here

# Metrics Endpoint (optional - external metrics collector)
# METRICS_ENDPOINT=https://your-metrics-collector.com/api/v1/metrics

# ==========================================
# FEATURE FLAGS
# ==========================================

# Feature Flags for Safe Rollback
# Format: FF_<FLAG_NAME>=true/false
# All flags default to false (disabled) for safety

# Use SQLite for Glossary repository (default: false)
# FF_USE_SQLITE_GLOSSARY=false

# Use SQLite for Translation Audit repository (default: false)
# FF_USE_SQLITE_TRANSLATION_AUDIT=false

# Use Provider pattern for User repository (default: false)
# FF_USE_PROVIDER_PATTERN_USERS=false

# Use Provider pattern for Translation repository (default: false)
# FF_USE_PROVIDER_PATTERN_TRANSLATIONS=false

# ==========================================
# SECURITY SETTINGS
# ==========================================

# Admin Secret (REQUIRED in production)
# Used to protect sensitive admin endpoints like account creation/password reset
# Generate a strong random secret: openssl rand -hex 32
# IMPORTANT: This must be set in production, or admin endpoints will be completely blocked
ADMIN_SECRET=your_random_admin_secret_here

# Allow Auth Bypass (Development only)
# Set to 'true' to bypass authentication in development mode
# WARNING: Only works when NODE_ENV=development. Completely disabled in production.
# ALLOW_AUTH_BYPASS=false
