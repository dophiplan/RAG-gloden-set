# ==========================================
# PRODUCTION ENVIRONMENT VARIABLES
# Copy these to Vercel Environment Variables
# ==========================================

# Supabase (Required) - Production Project
NEXT_PUBLIC_SUPABASE_URL=https://[your-prod-project].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# OpenAI API (Required) - AI Translation Service
OPENAI_API_KEY=sk-proj-...

# Anthropic API (Optional) - Context Review Feature
ANTHROPIC_API_KEY=sk-ant-...

# Application URL (Auto-set by Vercel)
NEXT_PUBLIC_APP_URL=https://translation-manager.vercel.app

# Email Provider (Optional)
EMAIL_PROVIDER=mock

# Node Environment (Auto-set by Vercel)
NODE_ENV=production

# ==========================================
# OBSERVABILITY SETTINGS
# ==========================================

# Log Level (debug | info | warn | error)
# Production default: info
LOG_LEVEL=info

# Enable Metrics Collection (true | false)
# Default: true
ENABLE_METRICS=true

# Metrics Token (for securing /api/metrics endpoint)
# Generate: openssl rand -hex 32
METRICS_TOKEN=your_secure_metrics_token_here

# Metrics Endpoint (optional - external metrics collector like Datadog)
# METRICS_ENDPOINT=https://api.datadoghq.com/api/v1/series

# ==========================================
# SECURITY SETTINGS
# ==========================================

# Admin Secret (REQUIRED in production)
# Generate a strong random secret: openssl rand -hex 32
ADMIN_SECRET=your_admin_secret_here
