{
  "name": "translation-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "verify": "node scripts/verify-setup.js",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest --reporter=verbose",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --reporter=json --reporter=verbose",
    "test:unit": "vitest run --exclude 'tests/integration/**' --reporter=verbose",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:integration:coverage": "vitest run --config vitest.integration.config.ts --coverage",
    "migrate:sqlite": "node sqlite/scripts/apply-sqlite-migrations.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "@google/generative-ai": "^0.24.1",
    "@sendgrid/mail": "^8.1.6",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.94.0",
    "@tanstack/react-virtual": "^3.13.20",
    "dotenv": "^17.2.4",
    "iconv-lite": "^0.7.2",
    "isomorphic-dompurify": "^3.0.0-rc.2",
    "next": "16.1.6",
    "nodemailer": "^8.0.1",
    "openai": "^6.17.0",
    "pdf-parse": "^1.1.1",
    "pdf-text-extract": "^1.5.0",
    "react": "19.2.3",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "19.2.3",
    "react-dropzone": "^15.0.0",
    "react-hot-toast": "^2.6.0",
    "string-similarity": "^4.0.4",
    "swr": "^2.4.1",
    "unpdf": "^1.4.0",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/string-similarity": "^4.0.2",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.4.0",
    "msw": "^2.12.10",
    "sqlite3": "^6.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
