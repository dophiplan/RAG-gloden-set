import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest';
import { NextRequest } from 'next/server';

// Mock next/headers
vi.mock('next/headers', () => ({
  cookies: vi.fn().mockReturnValue({
    getAll: vi.fn().mockReturnValue([]),
    set: vi.fn(),
  }),
}));

// Mock @/lib/api-auth - requireMasterRole를 모의하여 인증 로직 단순화
vi.mock('@/lib/api-auth', () => ({
  requireMasterRole: vi.fn(),
}));

// Mock Supabase server
vi.mock('@/lib/supabase/server', () => ({
  createClient: vi.fn(),
}));

// Mock feature flags
vi.mock('@/lib/config/feature_flags', async () => {
  const actual = await vi.importActual('@/lib/config/feature_flags');
  return {
    ...actual,
    isEnabled: vi.fn(),
  };
});

// Mock database provider
vi.mock('@/lib/database/provider', () => ({
  createDatabaseProviderFromEnv: vi.fn(),
}));

// Import after mocks
import { GET as getUsers } from '@/app/api/users/route';
import { GET as getUserById } from '@/app/api/users/[id]/route';
import { requireMasterRole } from '@/lib/api-auth';
import { isEnabled } from '@/lib/config/feature_flags';
import { createDatabaseProviderFromEnv } from '@/lib/database/provider';

const mockedRequireMasterRole = vi.mocked(requireMasterRole);
const mockedIsEnabled = vi.mocked(isEnabled);
const mockedCreateDatabaseProviderFromEnv = vi.mocked(createDatabaseProviderFromEnv);

describe('/api/users Dark Launch', () => {
  beforeEach(() => {
    vi.clearAllMocks();
    process.env.FF_USERS_DARK_LAUNCH = 'false';
    process.env.FF_USERS_FULL_CUTOVER = 'false';
  });
  
  afterEach(() => {
    delete process.env.FF_USERS_DARK_LAUNCH;
    delete process.env.FF_USERS_FULL_CUTOVER;
    vi.resetAllMocks();
  });

  // 인증 및 Supabase client mock 설정 헬퍼
  const setupAuthMock = (isAuthenticated = true, isMaster = true) => {
    if (!isAuthenticated) {
      mockedRequireMasterRole.mockResolvedValue({
        error: new Response(JSON.stringify({ error: '인증이 필요합니다.' }), { status: 401 }),
        user: null as any,
        adminClient: null as any,
      });
      return;
    }

    if (!isMaster) {
      mockedRequireMasterRole.mockResolvedValue({
        error: new Response(JSON.stringify({ error: '권한이 없습니다.' }), { status: 403 }),
        user: null as any,
        adminClient: null as any,
      });
      return;
    }

    // Supabase 체인 mock 헬퍼
    const createMockQuery = () => {
      const mockData = [
        { id: '1', name: 'User 1', email: 'user1@test.com', created_at: '2024-01-01' },
        { id: '2', name: 'User 2', email: 'user2@test.com', created_at: '2024-01-02' },
      ];

      const mockResponse = {
        data: mockData,
        error: null,
        count: 2,
      };

      // 체인 메소드들
      const rangeMock = vi.fn().mockResolvedValue(mockResponse);
      const orderMock = vi.fn().mockReturnValue({ range: rangeMock });
      const containsMock = vi.fn().mockReturnValue({ order: orderMock, range: rangeMock });
      const orMock = vi.fn().mockReturnValue({ order: orderMock, range: rangeMock });
      
      const selectMock = vi.fn().mockReturnValue({
        order: orderMock,
        eq: vi.fn().mockReturnValue({
          single: vi.fn().mockResolvedValue({
            data: { id: '1', name: 'User 1', email: 'user1@test.com' },
            error: null,
          }),
        }),
        contains: containsMock,
        or: orMock,
      });

      return { select: selectMock };
    };

    const mockQuery = createMockQuery();

    // 성공적인 인증
    mockedRequireMasterRole.mockResolvedValue({
      user: { id: 'user-1', email: 'test@example.com' },
      adminClient: {
        from: vi.fn().mockReturnValue(mockQuery),
      } as any,
      error: null,
    });
  };

  describe('GET /api/users (List)', () => {
    it('should use legacy when dark launch is disabled', async () => {
      process.env.FF_USERS_DARK_LAUNCH = 'false';
      mockedIsEnabled.mockImplementation((flag: string) => {
        if (flag === 'FF_USERS_FULL_CUTOVER') return false;
        if (flag === 'FF_USERS_DARK_LAUNCH') return false;
        return false;
      });
      setupAuthMock();
      
      const request = new NextRequest('http://localhost:3000/api/users');
      const response = await getUsers(request);
      
      expect(response.status).toBe(200);
      const result = await response.json();
      // apiSuccess 래퍼로 인해 { data: { users, pagination } } 형태로 반환
      expect(result.data).toBeDefined();
      expect(result.data.users).toBeDefined();
      expect(result.data.pagination).toBeDefined();
    });
    
    it('should execute dark launch when enabled', async () => {
      process.env.FF_USERS_DARK_LAUNCH = 'true';
      mockedIsEnabled.mockImplementation((flag: string) => {
        if (flag === 'FF_USERS_FULL_CUTOVER') return false;
        if (flag === 'FF_USERS_DARK_LAUNCH') return true;
        return false;
      });
      setupAuthMock();
      
      const mockProvider = {
        users: {
          findMany: vi.fn().mockResolvedValue({
            data: [{ id: '1', name: 'Provider User' }],
            count: 1,
          }),
        },
      };
      mockedCreateDatabaseProviderFromEnv.mockReturnValue(mockProvider as any);
      
      const request = new NextRequest('http://localhost:3000/api/users');
      const response = await getUsers(request);
      
      expect(response.status).toBe(200);
      const result = await response.json();
      expect(result.data).toBeDefined();
      expect(result.data.users).toBeDefined();
    });
    
    it('should return same structure as legacy', async () => {
      process.env.FF_USERS_DARK_LAUNCH = 'true';
      mockedIsEnabled.mockImplementation((flag: string) => {
        if (flag === 'FF_USERS_FULL_CUTOVER') return false;
        if (flag === 'FF_USERS_DARK_LAUNCH') return true;
        return false;
      });
      setupAuthMock();
      
      const mockProvider = {
        users: {
          findMany: vi.fn().mockResolvedValue({
            data: [{ id: '1', name: 'Provider User' }],
            count: 1,
          }),
        },
      };
      mockedCreateDatabaseProviderFromEnv.mockReturnValue(mockProvider as any);
      
      const request = new NextRequest('http://localhost:3000/api/users?page=1&limit=10');
      const response = await getUsers(request);
      
      const result = await response.json();
      expect(result.data).toBeDefined();
      expect(result.data).toHaveProperty('users');
      expect(result.data).toHaveProperty('pagination');
      expect(result.data.pagination).toHaveProperty('page');
      expect(result.data.pagination).toHaveProperty('limit');
      expect(result.data.pagination).toHaveProperty('total');
      expect(result.data.pagination).toHaveProperty('totalPages');
    });
    
    it('should handle pagination correctly', async () => {
      process.env.FF_USERS_DARK_LAUNCH = 'true';
      mockedIsEnabled.mockImplementation((flag: string) => {
        if (flag === 'FF_USERS_FULL_CUTOVER') return false;
        if (flag === 'FF_USERS_DARK_LAUNCH') return true;
        return false;
      });
      setupAuthMock();
      
      const mockProvider = {
        users: {
          findMany: vi.fn().mockResolvedValue({
            data: [{ id: '2', name: 'User 2' }],
            count: 5,
          }),
        },
      };
      mockedCreateDatabaseProviderFromEnv.mockReturnValue(mockProvider as any);
      
      const request = new NextRequest('http://localhost:3000/api/users?page=2&limit=5');
      const response = await getUsers(request);
      
      const result = await response.json();
      expect(result.data.pagination.page).toBe(2);
      expect(result.data.pagination.limit).toBe(5);
    });
    
    it('should handle search filter', async () => {
      process.env.FF_USERS_DARK_LAUNCH = 'true';
      mockedIsEnabled.mockImplementation((flag: string) => {
        if (flag === 'FF_USERS_FULL_CUTOVER') return false;
        if (flag === 'FF_USERS_DARK_LAUNCH') return true;
        return false;
      });
      setupAuthMock();
      
      const mockProvider = {
        users: {
          findMany: vi.fn().mockResolvedValue({
            data: [{ id: '1', name: 'Test User' }],
            count: 1,
          }),
        },
      };
      mockedCreateDatabaseProviderFromEnv.mockReturnValue(mockProvider as any);
      
      const request = new NextRequest('http://localhost:3000/api/users?search=test');
      const response = await getUsers(request);
      
      expect(response.status).toBe(200);
      const result = await response.json();
      expect(Array.isArray(result.data.users)).toBe(true);
    });
  });

  describe('GET /api/users/:id (Single)', () => {
    it('should return user by id with dark launch', async () => {
      process.env.FF_USERS_DARK_LAUNCH = 'true';
      mockedIsEnabled.mockImplementation((flag: string) => {
        if (flag === 'FF_USERS_FULL_CUTOVER') return false;
        if (flag === 'FF_USERS_DARK_LAUNCH') return true;
        return false;
      });
      
      const mockUser = { id: 'user-1', email: 'test@example.com' };
      const mockClient = {
        auth: {
          getUser: vi.fn().mockResolvedValue({
            data: { user: mockUser },
            error: null,
          }),
        },
        from: vi.fn().mockReturnValue({
          select: vi.fn().mockReturnValue({
            eq: vi.fn().mockReturnValue({
              single: vi.fn().mockResolvedValue({
                data: { id: 'test-user-id', name: 'Test User', roles: ['master'] },
                error: null,
              }),
            }),
          }),
        }),
      };
      
      // Override requireMasterRole for this specific test
      mockedRequireMasterRole.mockResolvedValue({
        user: mockUser,
        adminClient: mockClient as any,
        error: null,
      });
      
      const userId = 'test-user-id';
      const request = new NextRequest(`http://localhost:3000/api/users/${userId}`);
      const response = await getUserById(request, { params: Promise.resolve({ id: userId }) });
      
      // 사용자 존재 여부와 관계없이 200 또는 404
      expect([200, 404]).toContain(response.status);
    });
    
    it('should return 404 for non-existent user', async () => {
      process.env.FF_USERS_DARK_LAUNCH = 'true';
      mockedIsEnabled.mockReturnValue(false);
      
      const mockUser = { id: 'user-1', email: 'test@example.com' };
      const mockClient = {
        auth: {
          getUser: vi.fn().mockResolvedValue({
            data: { user: mockUser },
            error: null,
          }),
        },
        from: vi.fn().mockReturnValue({
          select: vi.fn().mockReturnValue({
            eq: vi.fn().mockReturnValue({
              single: vi.fn().mockResolvedValue({
                data: null,
                error: { message: 'Not found' },
              }),
            }),
          }),
        }),
      };
      
      mockedRequireMasterRole.mockResolvedValue({
        user: mockUser,
        adminClient: mockClient as any,
        error: null,
      });
      
      const request = new NextRequest('http://localhost:3000/api/users/non-existent-id');
      const response = await getUserById(request, { params: Promise.resolve({ id: 'non-existent-id' }) });
      
      expect(response.status).toBe(404);
    });
    
    it('should return same structure as legacy', async () => {
      process.env.FF_USERS_DARK_LAUNCH = 'true';
      mockedIsEnabled.mockReturnValue(false);
      
      const mockUser = { id: 'user-1', email: 'test@example.com' };
      const mockTargetUser = { id: 'test-user-id', name: 'Test User', email: 'test@test.com' };
      
      const mockClient = {
        auth: {
          getUser: vi.fn().mockResolvedValue({
            data: { user: mockUser },
            error: null,
          }),
        },
        from: vi.fn().mockReturnValue({
          select: vi.fn().mockReturnValue({
            eq: vi.fn().mockReturnValue({
              single: vi.fn().mockResolvedValue({
                data: mockTargetUser,
                error: null,
              }),
            }),
          }),
        }),
      };
      
      mockedRequireMasterRole.mockResolvedValue({
        user: mockUser,
        adminClient: mockClient as any,
        error: null,
      });
      
      const userId = 'test-user-id';
      const request = new NextRequest(`http://localhost:3000/api/users/${userId}`);
      const response = await getUserById(request, { params: Promise.resolve({ id: userId }) });
      
      if (response.status === 200) {
        const result = await response.json();
        expect(result.data).toHaveProperty('user');
      }
    });
  });

  describe('Error Handling', () => {
    it('should require authentication', async () => {
      process.env.FF_USERS_DARK_LAUNCH = 'true';
      mockedIsEnabled.mockReturnValue(false);
      setupAuthMock(false);
      
      const request = new NextRequest('http://localhost:3000/api/users');
      const response = await getUsers(request);
      
      // 인증 실패 시 401
      expect([401, 403]).toContain(response.status);
    });
    
    it('should handle provider failure gracefully', async () => {
      process.env.FF_USERS_DARK_LAUNCH = 'true';
      mockedIsEnabled.mockImplementation((flag: string) => {
        if (flag === 'FF_USERS_FULL_CUTOVER') return false;
        if (flag === 'FF_USERS_DARK_LAUNCH') return true;
        return false;
      });
      setupAuthMock();
      
      const request = new NextRequest('http://localhost:3000/api/users');
      const response = await getUsers(request);
      
      // Provider 실패핏도 200 또는 인증 에러
      expect([200, 401, 403]).toContain(response.status);
    });
  });
});
