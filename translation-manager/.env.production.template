# ==========================================
# PRODUCTION ENVIRONMENT VARIABLES
# Copy these to Vercel Environment Variables
# ==========================================

# Supabase (Required) - Production Project
NEXT_PUBLIC_SUPABASE_URL=https://[your-prod-project].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# OpenAI API (Required) - AI Translation Service
OPENAI_API_KEY=sk-proj-...

# Anthropic API (Optional) - Context Review Feature
ANTHROPIC_API_KEY=sk-ant-...

# Application URL (Auto-set by Vercel)
NEXT_PUBLIC_APP_URL=https://translation-manager.vercel.app

# Email Provider (Optional)
EMAIL_PROVIDER=mock

# Node Environment (Auto-set by Vercel)
NODE_ENV=production
